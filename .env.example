VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>

# @username бота из BotFather (без @)
VITE_BOT_USERNAME=your_bot
# short name мини-аппы из BotFather -> Bot Settings -> Mini App
# нужен для ссылки t.me/<bot>/<app>?startapp=duel_<id>
VITE_APP_SHORT_NAME=quiz

# Необязательно: реальный initData, скопированный из Telegram-клиента,
# чтобы запросы к Edge Function работали при `npm run dev` в браузере.
# VITE_DEV_INIT_DATA=
